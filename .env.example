# Copy this file to .env and fill in your own keys. Never commit .env.
# Leave keys empty to run in OFFLINE mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI-compatible provider (e.g. Groq)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=qwen/qwen3.8-27b
OPENAI_FALLBACK_MODELS=allam-2-7b,openai/gpt-oss-120b
LLM_PROVIDER=openai